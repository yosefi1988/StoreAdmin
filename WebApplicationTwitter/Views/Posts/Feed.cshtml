@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "فید";
}

<style>
    /* ===== چیدمان فید ===== */
    .feed-wrapper {
        max-width: 1200px !important;
        margin: 20px auto !important;
        padding: 0 15px !important;
    }

    .feed-layout {
        display: flex !important;
        gap: 20px !important;
        align-items: flex-start !important;
        direction: rtl !important;
    }

    .feed-sidebar {
        width: 260px !important;
        flex-shrink: 0 !important;
        position: sticky !important;
        top: 90px !important;
    }

    .feed-main {
        flex: 1 !important;
        min-width: 0 !important;
        width: 100% !important;
    }

    /* ===== اصلاح باکس ارسال پست ===== */
    .post-composer {
        margin-top: 0 !important;
    }

    .composer-title {
        margin-top: 0 !important;
        margin-bottom: 12px !important;
    }

    /* ===== موبایل ===== */
    @@media (max-width: 768px) {
        .feed-layout {
            flex-direction: column !important;
        }

        .feed-sidebar {
            width: 100% !important;
            position: static !important;
        }
    }
</style>
<div class="feed-wrapper">

    <div class="feed-layout">

        <!-- ========== سایدبار: سوئیچر فروشگاه ========== -->
        <aside class="feed-sidebar">
            <div class="store-switcher card">
                <div class="card-header">
                    <i class="fa fa-store"></i>
                    <span>فروشگاه فعال</span>
                </div>

                <div id="storeSwitcherBody" class="card-body p-2">
                    <div id="storeLoading" class="text-center py-2" style="display:none;">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                    </div>

                    <div id="storeCurrent" class="mb-2"></div>

                    <select id="storeSelect" class="form-control form-control-sm" style="display:none;"></select>

                    <!-- 🔴 هیچ دکمه‌ای اینجا نباید باشد -->

                    <div id="storeError" class="text-danger small mt-2" style="display:none;"></div>
                </div>
            </div>
        </aside>

        <!-- ========== محتوای اصلی ========== -->
        <main class="feed-main">

            <!-- باکس ارسال پست -->
            <div class="post-composer">
                <h5 class="composer-title" >
                    <i class="fa fa-pencil"></i> چه خبر؟
                </h5>

                <div id="composerAlert" class="alert alert-danger" style="display:none;"></div>

                <input style="display:none" type="text" id="postTitle" class="form-control mb-2"
                       maxlength="400" placeholder="عنوان (اختیاری ولی توصیه‌شده)" />

                <textarea id="postContent" class="form-control mb-2" rows="3"
                          maxlength="2000" placeholder="متن پست..."></textarea>

                <!-- بخش تصاویر -->
                <div class="mb-2">
                    <label class="small text-muted mb-1">
                        <i class="fa fa-image"></i> تصاویر (اختیاری)
                    </label>

                    <input type="file" id="postImagesInput"
                           class="form-control form-control-sm"
                           accept="image/*" multiple />

                    <small class="text-muted d-block mt-1">
                        می‌توانید چند تصویر انتخاب کنید (jpg, png, gif, webp — حداکثر ۵MB هر فایل)
                    </small>

                    <div id="selectedFilesPreview"
                         class="d-flex flex-wrap gap-2 mt-2"></div>

                    <div id="uploadedImagesList" class="mt-2"></div>

                    <button type="button" id="btnUploadPostImages"
                            class="btn btn-outline-secondary btn-sm mt-2">
                        <i class="fa fa-upload"></i> آپلود تصاویر
                    </button>

                    <input type="hidden" id="postImageUrls" value="" />
                </div>

                <div class="composer-footer">
                    <span id="charCount" class="text-muted small">0 / 2000</span>
                    <div>
                        <a href="@Url.Action("Scroll", "Products")" id="btnSearchRedirect" class="btn btn-default">
                            <i class="fa fa-search"></i> جستجو
                        </a>
                        <button type="button" class="btn btn-primary" id="btnSubmitPost">
                            <i class="fa fa-send"></i> ارسال
                        </button>
                    </div>
                </div>
            </div>

            <!-- فید -->
            <div id="feedContainer"></div>

            <!-- loading -->
            <div id="feedLoading" class="feed-loading" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="sr-only">در حال بارگذاری...</span>
                </div>
                <p class="mt-2 text-muted small">در حال بارگذاری...</p>
            </div>

            <!-- پایان -->
            <div id="feedEnd" class="feed-end" style="display:none;">
                — به پایان فید رسیدید —
            </div>

            <!-- خطا -->
            <div id="feedError" class="alert alert-danger" style="display:none;"></div>

        </main>

    </div>

</div>

<!-- ============================================================ -->
<!-- Modal: کامنت‌ها (بدون تغییر)                                  -->
<!-- ============================================================ -->
<div class="modal fade" id="commentsModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa fa-comments"></i> نظرات
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="بستن">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="modalPostPreview" class="modal-post-preview"></div>
                <hr />
                <div class="comment-form mb-3">
                    <textarea id="newCommentText" class="form-control mb-2" rows="2"
                              maxlength="4000" placeholder="نظر خود را بنویسید..."></textarea>
                    <button type="button" class="btn btn-sm btn-primary" id="btnAddComment">
                        <i class="fa fa-send"></i> ارسال نظر
                    </button>
                </div>
                <div id="commentsList"></div>
                <div id="commentsLoading" class="text-center py-3" style="display:none;">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                </div>
                <div id="commentsEmpty" class="text-center text-muted py-3" style="display:none;">
                    هنوز نظری ثبت نشده. اولین نفر باشید!
                </div>
                <div id="commentsEnd" class="text-center text-muted small py-2" style="display:none;">
                    — به پایان نظرات رسیدید —
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            var token = tokenInput ? tokenInput.value : '';
            if (!token) {
                var temp = document.createElement('div');
                temp.innerHTML = '@Html.AntiForgeryToken()';
                var hidden = temp.querySelector('input[name="__RequestVerificationToken"]');
                if (hidden) token = hidden.value;
            }

            window.FeedConfig = {
                baseUrl: '@Url.Content("~/")',
                isLoggedIn: @(User.Identity.IsAuthenticated.ToString().ToLower()),
                loginUrl: '@Url.Action("Index", "Login")',
                antiForgeryToken: token
            };
        })();
    </script>
    <script src="~/Scripts/feed.js"></script>
}