@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "همه پست‌ها";
}

<div class="feed-wrapper">

    <!-- ========== باکس جستجو (شبیه باکس ارسال پست) ========== -->
    <div class="post-composer" >
        <h5 class="composer-title">
            <i class="fa fa-search"></i> جستجو در پست‌ها
        </h5>

        <form id="searchForm" onsubmit="return false;">
            <div class="input-group">
                <input type="text" id="searchInput" class="form-control"
                       placeholder="عنوان، متن یا نویسنده..." />
                <span class="input-group-btn">
                    <button type="button" id="btnSearch" class="btn btn-primary">
                        <i class="fa fa-search"></i> جستجو
                    </button>
                </span>
            </div>
        </form>
    </div>

    <!-- ========== لیست پست‌ها ========== -->
    <div id="postsContainer"></div>

    <!-- ========== loading ========== -->
    <div id="loading" class="feed-loading" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">در حال بارگذاری...</span>
        </div>
        <p class="mt-2 text-muted small">در حال بارگذاری...</p>
    </div>

    <!-- ========== پایان ========== -->
    <div id="endMessage" class="feed-end" style="display:none;">
        — به پایان لیست رسیدید —
    </div>

    <!-- ========== خطا ========== -->
    <div id="error" class="alert alert-danger" style="display:none;"></div>

</div>

@section Scripts {
    <script>
        var ApiClient = {
            baseUrl: '@Url.Content("~/")'
        }; 
        window.PostsFilter = {
            currentSearch:'d',
            search: '',
            sort: 'likes', // ← این خط را اضافه کنید (برای بار اول: بیشترین لایک)
        };
    </script>
    <script src="~/Scripts/posts-scroll.js"></script>
}