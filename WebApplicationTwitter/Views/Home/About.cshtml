@model WebApplicationTwitter.Models.HomeViewModel

@{
    ViewBag.Title = "درباره ما";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- about section start -->
<div class="about_section layout_padding">
    <div class="container">
        <div class="about_section_2">
            <div class="row">
                <div class="col-md-6">
                    <div class="image_iman"><img src="~/Content/trator-1.0.0/images/about-img.png" class="about_img" alt="درباره ما"></div>
                </div>
                <div class="col-md-6">
                    <div class="about_taital_box">
                        <h1 class="about_taital">درباره <span style="color: #fe5b29;">ما</span></h1>
                        <p class="about_text">
                            @Model.Settings.Description
                        </p>
                        <div class="readmore_btn">
                            <a href="@Url.Action("Index", "Home")">بازگشت به صفحه اصلی</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- about section end -->
<!-- search section start -->
<div class="search_section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1 class="search_taital" style="color: #fff;">پست‌ها را جستجو کنید</h1>
                <p class="search_text" style="color: #eee;">با جستجوی سریع و آسان، موضوع موردنظرتان را پیدا کنید.</p>

                <div class="select_box_section">
                    <div class="select_box_main">
                        @using (Html.BeginForm("Scroll", "Products", FormMethod.Get))
                        {
                            <div class="row" style="align-items: center; justify-content: center;">
                                <!-- فیلد جستجو -->
                                <div class="col-md-8 col-sm-12 mb-3">
                                    <input type="text" name="search" class="form-control"
                                           placeholder="عنوان، متن یا نام فروشگاه را وارد کنید..."
                                           style="height: 50px; border-radius: 5px; padding: 10px 15px;" />
                                </div>

                                <!-- دکمه جستجو -->
                                <div class="col-md-4 col-sm-12 mb-3">
                                    <button type="submit" class="btn btn-primary"
                                            style="width: 100%; height: 50px; border-radius: 5px; font-weight: bold; background-color: #fe5b29; border-color: #fe5b29;">
                                        <i class="fa fa-search"></i> جستجو
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- search section end -->