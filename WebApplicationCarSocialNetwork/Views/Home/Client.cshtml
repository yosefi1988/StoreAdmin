<!-- client section start -->
<div class="client_section layout_padding">
    <div class="container">

        @{
            var firstSlide = true;
        }

        <div id="custom_slider" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">

                @foreach (var group in Model.CommentsGrouped)
                {
                    <div class="carousel-item @(firstSlide ? "active" : "")">
                        <div class="row">
                            <div class="col-md-12">
                                <h1 class="client_taital">نظرات مشتریان</h1>
                            </div>
                        </div>
                        <div class="client_section_2">
                            <div class="row">

                                @foreach (var item in group)
                                {
                                    <div class="col-md-6">
                                        <div class="client_taital_box">
                                            <div class="client_img">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl1))
                                                {
                                                    <img src="@item.ImageUrl1" alt="@item.FullName">
                                                }
                                                else
                                                {
                                                    <img src="~/Content/trator-1.0.0/images/client-img1.png" alt="@item.FullName">
                                                }
                                            </div>
                                            <h3 class="moark_text">@item.FullName</h3>
                                            <p class="client_text">@item.Message</p>
                                        </div>
                                        <div class="quick_icon">
                                            <img src="~/Content/trator-1.0.0/images/quick-icon.png">
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>

                    firstSlide = false;
                }

                @if (Model.CommentsGrouped == null || Model.CommentsGrouped.Count == 0)
                {
                    <div class="carousel-item active">
                        <div class="row">
                            <div class="col-md-12">
                                <h1 class="client_taital">نظرات مشتریان</h1>
                                <p style="text-align:center;">هنوز نظری ثبت نشده است.</p>
                            </div>
                        </div>
                    </div>
                }

            </div>

            <a class="carousel-control-prev" href="#custom_slider" role="button" data-slide="prev">
                <i class="fa fa-angle-left"></i>
            </a>
            <a class="carousel-control-next" href="#custom_slider" role="button" data-slide="next">
                <i class="fa fa-angle-right"></i>
            </a>
        </div>
