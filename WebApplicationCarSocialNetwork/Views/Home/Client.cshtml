<!-- gallery section start -->
<div class="gallery_section layout_padding">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1 class="gallery_taital">آخرین ماشین‌های ثبت‌شده</h1>
            </div>
        </div>

        @{
            var cars = Model.LatestCars.ToList();
            int itemsPerRow = 3;
        }

        @for (int i = 0; i < cars.Count; i += itemsPerRow)
        {
            <div class="gallery_section_2">
                <div class="row">
                    @for (int j = i; j < i + itemsPerRow && j < cars.Count; j++)
                    {
                        var car = cars[j];
                        <div class="col-md-4">
                            <div class="gallery_box">
                                <div class="gallery_img">
                                    <a href="@Url.Action("Details", "Products", new { id = car.ProductId })">
                                        <img src="@car.ImageUrl" alt="@car.NameFa">
                                    </a>
                                </div>
                                <h3 class="types_text">@car.NameFa</h3>
                                <p class="looking_text">
                                    @(car.Price.HasValue ? car.Price.Value.ToString("N0") + " تومان" : "تماس بگیرید")
                                </p>
                                <div class="read_bt">
                                    <a href="@Url.Action("Details", "Products", new { id = car.ProductId })">مشاهده</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>


</div>
 

<!-- gallery section end -->
