@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "پست";
}

<div class="post-detail-wrapper">

    <!-- ========== پست کامل ========== -->
    <div id="postDetailLoading" class="text-center py-4">
        <div class="spinner-border text-primary"></div>
        <p class="text-muted small mt-2">در حال بارگذاری...</p>
    </div>

    <div id="postDetailError" class="alert alert-danger" style="display:none;"></div>

    <div id="postDetailCard" class="post-detail-card" style="display:none;"></div>

    <!-- ========== فرم کامنت ========== -->
    <div class="comment-form-card mt-3">
        <h6 class="mb-2">
            <i class="fa fa-comment"></i> نظر شما
        </h6>

        <div id="commentAlert" class="alert alert-danger" style="display:none;"></div>

        <textarea id="newCommentText" class="form-control mb-2" rows="3"
                  maxlength="4000" placeholder="نظر خود را بنویسید..."></textarea>

        <!-- تصاویر کامنت -->
        <div class="mb-2">
            <label class="small text-muted mb-1">
                <i class="fa fa-image"></i> تصاویر (اختیاری)
            </label>

            <input type="file" id="commentImagesInput"
                   class="form-control form-control-sm"
                   accept="image/*" multiple />

            <small class="text-muted d-block mt-1">
                چند تصویر — jpg, png, gif, webp — حداکثر ۵MB هر فایل
            </small>

            <div id="commentSelectedPreview"
                 class="d-flex flex-wrap gap-2 mt-2"></div>

            <div id="commentUploadedList" class="mt-2"></div>

            <button type="button" id="btnUploadCommentImages"
                    class="btn btn-outline-secondary btn-sm mt-2">
                <i class="fa fa-upload"></i> آپلود تصاویر
            </button>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <span id="commentCharCount" class="text-muted small">0 / 4000</span>
            <button type="button" class="btn btn-primary" id="btnSubmitComment">
                <i class="fa fa-send"></i> ارسال نظر
            </button>
        </div>
    </div>

    <!-- ========== لیست کامنت‌ها ========== -->
    <div class="comments-section mt-4">
        <h6 class="mb-3">
            <i class="fa fa-comments"></i>
            نظرات (<span id="commentsTotalCount">0</span>)
        </h6>

        <div id="commentsList"></div>

        <div id="commentsLoading" class="text-center py-3" style="display:none;">
            <div class="spinner-border spinner-border-sm text-primary"></div>
            <p class="text-muted small mt-2">در حال بارگذاری...</p>
        </div>

        <div id="commentsEmpty" class="text-center text-muted py-4" style="display:none;">
            <i class="fa fa-comments-o fa-2x mb-2" style="color:#ccc;"></i>
            <p>هنوز نظری ثبت نشده. اولین نفر باشید!</p>
        </div>

        <div id="commentsEnd" class="text-center text-muted small py-2" style="display:none;">
            — به پایان نظرات رسیدید —
        </div>
    </div>
</div>

@section Styles {
    <style>
        .post-detail-wrapper {
            max-width: 720px;
            margin: 20px auto;
            padding: 0 10px;
        }

        /* ============ Post Card ============ */
        .post-detail-card {
            background: #fff;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 18px;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

            .post-detail-card .post-header {
                display: flex;
                align-items: center;
                margin-bottom: 14px;
            }

            .post-detail-card .post-avatar {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: #f0f0f0;
                object-fit: cover;
                margin-left: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #999;
                font-weight: bold;
                flex-shrink: 0;
            }

            .post-detail-card .post-author-info {
                flex: 1;
                min-width: 0;
            }

            .post-detail-card .post-author {
                font-weight: 600;
                color: #222;
                font-size: 15px;
            }

            .post-detail-card .post-username {
                color: #888;
                font-size: 12px;
            }

            .post-detail-card .post-time {
                color: #aaa;
                font-size: 12px;
                white-space: nowrap;
            }

            .post-detail-card .post-title {
                font-weight: 700;
                color: #222;
                margin: 10px 0 6px 0;
                font-size: 18px;
            }

            .post-detail-card .post-content {
                color: #333;
                line-height: 1.8;
                margin: 8px 0;
                white-space: pre-wrap;
                word-break: break-word;
                font-size: 15px;
            }

            /* تصاویر پست */
            .post-detail-card .post-image-single {
                width: 100%;
                border-radius: 8px;
                margin-top: 12px;
                max-height: 600px;
                object-fit: contain;
                background: #fafafa;
            }

            .post-detail-card .post-image-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 6px;
                margin-top: 12px;
            }

                .post-detail-card .post-image-grid img {
                    width: 100%;
                    height: 220px;
                    object-fit: cover;
                    border-radius: 8px;
                    cursor: zoom-in;
                }

                    .post-detail-card .post-image-grid img:hover {
                        opacity: .92;
                    }

            /* Actions */
            .post-detail-card .post-actions {
                display: flex;
                gap: 20px;
                margin-top: 14px;
                padding-top: 12px;
                border-top: 1px solid #f0f0f0;
            }

            .post-detail-card .post-action {
                background: none;
                border: none;
                color: #666;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 6px 10px;
                font-size: 14px;
                border-radius: 6px;
                transition: background .15s;
            }

                .post-detail-card .post-action:hover {
                    background: #f5f5f5;
                }

                .post-detail-card .post-action.liked {
                    color: #e0245e;
                }

                    .post-detail-card .post-action.liked:hover {
                        background: #fdeef4;
                    }

        /* ============ Comment Form ============ */
        .comment-form-card {
            background: #fff;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 15px;
        }

            .comment-form-card textarea {
                resize: vertical;
            }

        /* ============ Comments ============ */
        .comments-section {
            background: #fff;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 15px;
        }

        .comment-item {
            display: flex;
            gap: 10px;
            padding: 12px 0;
            border-bottom: 1px solid #f0f0f0;
        }

            .comment-item:last-child {
                border-bottom: none;
            }

        .comment-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #f0f0f0;
            object-fit: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #999;
            font-weight: bold;
            flex-shrink: 0;
        }

        .comment-body {
            flex: 1;
            min-width: 0;
        }

        .comment-author {
            font-weight: 600;
            font-size: 13px;
            color: #222;
        }

        .comment-time {
            font-size: 11px;
            color: #aaa;
            margin-right: 6px;
        }

        .comment-text {
            font-size: 14px;
            color: #333;
            margin-top: 4px;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .comment-images {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 8px;
        }

            .comment-images img {
                width: 90px;
                height: 90px;
                object-fit: cover;
                border-radius: 6px;
                border: 1px solid #eee;
                cursor: zoom-in;
            }

        /* ============ Responsive ============ */
        @@media (max-width: 576px) {
            .post-detail-wrapper {
                margin: 10px auto;
            }

            .post-detail-card .post-image-grid img {
                height: 150px;
            }
        }
    </style>
}

@section Scripts {
    <script>
        window.PostDetailConfig = {
            baseUrl: '@Url.Content("~/")',
            loginUrl: '@Url.Action("Index", "Login")',
            feedUrl: '@Url.Action("Feed", "Posts")',
            resourceId: @ViewBag.ResourceId
        };
    </script>
    <script src="~/Scripts/post-detail.js"></script>
}