@model IEnumerable<WebApplicationStoreAdmin.Models.ViewModel.ProductResourceViewModel>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>

<!-- سرچ -->
<div class="row" style="margin-bottom:10px;">
    <div class="col-md-4">
        <input type="text" id="txtSearch" class="form-control" placeholder="جستجوی محصول (نام، کد، بارکد)..." />
    </div>
</div>

<table class="table table-striped table-bordered" id="tblProducts">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.ResourceId) (شناسه)</th>
            <th>@Html.DisplayNameFor(model => model.NameFa) (نام فارسی)</th>
            <th>@Html.DisplayNameFor(model => model.NameEn) (نام انگلیسی)</th>
            <th>@Html.DisplayNameFor(model => model.Description) (توضیحات)</th>
            <th>@Html.DisplayNameFor(model => model.ImageUrl) (تصویر)</th>
            <th>@Html.DisplayNameFor(model => model.ProductCode) (کد محصول)</th>
            <th>@Html.DisplayNameFor(model => model.Barcode) (بارکد)</th>
            <th>@Html.DisplayNameFor(model => model.ResourceIsActive) (فعال)</th>
            <th>@Html.DisplayNameFor(model => model.ResourceCreatedAt) (تاریخ ایجاد)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ResourceId)</td>
                <td>@Html.DisplayFor(modelItem => item.NameFa)</td>
                <td>@Html.DisplayFor(modelItem => item.NameEn)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.ImageUrl)</td>
                <td>@Html.DisplayFor(modelItem => item.ProductCode)</td>
                <td>@Html.DisplayFor(modelItem => item.Barcode)</td>
                <td>@Html.DisplayFor(modelItem => item.ResourceIsActive)</td>
                <td>@Html.DisplayFor(modelItem => item.ResourceCreatedAt)</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.ResourceId }) |
                    @Html.ActionLink("Details", "Details", new { id = item.ResourceId }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.ResourceId })
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            $('#txtSearch').on('keyup', function () {
                var value = $(this).val().toLowerCase().trim();

                $('#tblProducts tbody tr').filter(function () {
                    // متن کل ردیف رو بگیر و مقایسه کن
                    var rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.indexOf(value) > -1);
                });
            });
        });
    </script>
}