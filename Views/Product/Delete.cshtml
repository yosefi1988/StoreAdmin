@model WebApplicationStoreAdmin.Models.ViewModel.ProductResourceViewModel


@{
    ViewBag.Title = "Delete";
}

<h2>Delete</h2>

<h3>آیا از حذف این مورد مطمئن هستید؟</h3>
<div>
    <h4>Product / Resource</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.ResourceId) (شناسه)</dt>
        <dd>@Html.DisplayFor(model => model.ResourceId)</dd>

        <dt>@Html.DisplayNameFor(model => model.NameFa) (نام فارسی)</dt>
        <dd>@Html.DisplayFor(model => model.NameFa)</dd>

        <dt>@Html.DisplayNameFor(model => model.NameEn) (نام انگلیسی)</dt>
        <dd>@Html.DisplayFor(model => model.NameEn)</dd>

