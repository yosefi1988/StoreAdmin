@model WebApplicationStoreAdmin.Models.ViewModel.ResourceCategoriesViewModel

@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>ویرایش دسته‌بندی‌های محصول</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ResourceId)

        <div class="form-group">
            @Html.Label("محصول", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static">@Model.ResourceNameFa</p>
            </div>
        </div>

        <div class="form-group">
            @Html.Label("دسته‌بندی‌ها", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @foreach (var cat in Model.AllCategories)
                {
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" name="SelectedCategoryIds" value="@cat.CategoryId"
                                   @(cat.Selected ? "checked" : "") />
                            @cat.NameFa
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}