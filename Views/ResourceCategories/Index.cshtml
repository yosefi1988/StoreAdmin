@model IEnumerable<WebApplicationStoreAdmin.Models.ViewModel.ResourceCategoriesViewModel>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>

<!-- سرچ -->
<div class="row" style="margin-bottom:10px;">
    <div class="col-md-4">
        <input type="text" id="txtSearch" class="form-control" placeholder="جستجوی محصول یا دسته‌بندی..." />
    </div>
</div>

<table class="table table-striped table-bordered" id="tblResourceCategories">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.ResourceId) (شناسه)</th>
            <th>@Html.DisplayNameFor(model => model.ResourceNameFa) (نام محصول)</th>
            <th>@Html.DisplayNameFor(model => model.ResourceNameEn) (نام انگلیسی)</th>
            <th>@Html.DisplayNameFor(model => model.ResourceImageUrl) (تصویر)</th>
            <th>@Html.DisplayNameFor(model => model.ResourceIsActive) (فعال)</th>
            <th>دسته‌بندی‌ها</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ResourceId)</td>
                <td>@Html.DisplayFor(modelItem => item.ResourceNameFa)</td>
                <td>@Html.DisplayFor(modelItem => item.ResourceNameEn)</td>
                <td>@Html.DisplayFor(modelItem => item.ResourceImageUrl)</td>
                <td>@Html.DisplayFor(modelItem => item.ResourceIsActive)</td>
                <td>
                    @if (item.SelectedCategoryNames != null && item.SelectedCategoryNames.Any())
                    {
                        <ul style="margin:0; padding-right:15px;">
                            @foreach (var catName in item.SelectedCategoryNames)
                            {
                                <li>@catName</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">بدون دسته‌بندی</span>
                    }
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.ResourceId }) |
                    @Html.ActionLink("Details", "Details", new { id = item.ResourceId }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.ResourceId })
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            $('#txtSearch').on('keyup', function () {
                var value = $(this).val().toLowerCase().trim();
                $('#tblResourceCategories tbody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}