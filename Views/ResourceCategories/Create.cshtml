@model WebApplicationStoreAdmin.Models.ViewModel.ResourceCategoriesViewModel

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>تخصیص دسته‌بندی به محصول</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.Label("ResourceId", "محصول", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("ResourceId",
                    (IEnumerable<SelectListItem>)ViewBag.ResourceId,
                    "انتخاب محصول...",
                    new { @class = "form-control select2-resource", @id = "ddlResource" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("دسته‌بندی‌ها", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div style="max-height:400px; overflow-y:auto; border:1px solid #ddd; padding:10px; border-radius:4px;">
                    @foreach (var cat in Model.AllCategories)
                    {
                        <div class="checkbox">
                            <label>
                                <input type="checkbox" name="SelectedCategoryIds" value="@cat.CategoryId" />
                                @cat.NameFa
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Select2 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {

            // Select2 روی Dropdown انتخاب محصول
            $('#ddlResource').select2({
                placeholder: "جستجوی محصول (نام یا کد)...",
                allowClear: true,
                width: '100%',
                dir: 'rtl',
                language: {
                    noResults: function () { return "محصولی یافت نشد"; },
                    searching: function () { return "در حال جستجو..."; }
                }
            });
        });
    </script>
}