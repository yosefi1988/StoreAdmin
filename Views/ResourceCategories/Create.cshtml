@model WebApplicationStoreAdmin.Models.ViewModel.ResourceCategoriesViewModel

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>تخصیص دسته‌بندی به محصول</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.Label("ResourceId", "محصول", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("ResourceId", (SelectList)ViewBag.ResourceId, "انتخاب محصول...", new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("دسته‌بندی‌ها", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @foreach (var cat in Model.AllCategories)
                {
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" name="SelectedCategoryIds" value="@cat.CategoryId" />
                            @cat.NameFa
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}