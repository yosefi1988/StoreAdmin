@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Select2 برای قابل جستجو شدن -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            // فعال‌سازی Select2 روی همه Dropdownها
            $('.select2').select2({
                placeholder: "جستجو کنید...",
                allowClear: true,
                width: '100%'
            });

            // تغییر کشور → بارگذاری استان‌ها
            $('#ddlCountry').change(function () {
                var countryId = $(this).val();
                $('#ddlProvince').empty().append('<option value="">انتخاب استان...</option>');
                $('#ddlCity').empty().append('<option value="">انتخاب شهر...</option>');

                if (countryId) {
                    $.get('@Url.Action("GetProvinces", "StoreDetails")', { countryId: countryId }, function (data) {
                        $.each(data, function (i, item) {
                            $('#ddlProvince').append('<option value="' + item.Id + '">' + item.Name + '</option>');
                        });
                        $('#ddlProvince').trigger('change.select2');
                    });
                }
            });

            // تغییر استان → بارگذاری شهرها
            $('#ddlProvince').change(function () {
                var provinceId = $(this).val();
                $('#ddlCity').empty().append('<option value="">انتخاب شهر...</option>');

                if (provinceId) {
                    $.get('@Url.Action("GetCities", "StoreDetails")', { provinceId: provinceId }, function (data) {
                        $.each(data, function (i, item) {
                            $('#ddlCity').append('<option value="' + item.Id + '">' + item.Name + '</option>');
                        });
                        $('#ddlCity').trigger('change.select2');
                    });
                }
            });
        });
    </script>
