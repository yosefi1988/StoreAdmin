                        <p class="footer_text">برای اشتراک در ماهنامه، @Model.Settings.StoreNameFa آدرس ایمیل خود را وارد و درخواست را ثبت نمایید.</p>
                        <div class="form-group">
                            <textarea class="update_mail" placeholder="آدرس ایمیل" rows="5" id="newsletterEmail"></textarea>
                            <div class="subscribe_bt">
                                <a href="javascript:void(0)" onclick="subscribeNewsletter()">عضویت</a>
                            </div>
                        </div>
                    </div>
                    <script>
                        function subscribeNewsletter() {
                            var email = document.getElementById('newsletterEmail').value;
                            var data = new FormData();
                            data.append('email', email);

                            fetch('@Url.Action("SubscribeNewsletter", "Home")', {
                                method: 'POST',
                                body: data
                            })
                            .then(r => r.json())
                            .then(res => {
                                alert(res.message);
                                if (res.success) document.getElementById('newsletterEmail').value = '';
                            });
                        }
                    </script>


