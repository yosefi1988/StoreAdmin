@{
    ViewBag.Title = "ثبت‌نام";
}

<div class="container" style="margin-top:20px;">
    <h2>ثبت‌نام</h2>
    <hr />

    <div class="wizard-steps">
        <div class="wizard-step active" data-step="1"><span class="step-number">1</span><span class="step-title">اطلاعات پایه</span></div>
        <div class="wizard-step" data-step="2"><span class="step-number">2</span><span class="step-title">تأیید موبایل</span></div>
        <div class="wizard-step" data-step="3"><span class="step-number">3</span><span class="step-title">تعیین رمز</span></div>
        <div class="wizard-step" data-step="4"><span class="step-number">4</span><span class="step-title">خلاصه و ثبت</span></div>
    </div>

    <hr />

    <div class="wizard-panel" id="step-1">
        <div class="form-group">
            <label>موبایل *</label>
            <input type="text" id="MobileNumber" class="form-control" placeholder="09xxxxxxxxx" />
        </div>
        <div class="form-group">
            <label>ایمیل (اختیاری)</label>
            <input type="email" id="Email" class="form-control" />
        </div>
        <div class="form-group">
            <label>نام کاربری (اختیاری)</label>
            <input type="text" id="UserName" class="form-control" />
        </div>
    </div>

    <div class="wizard-panel" id="step-2" style="display:none;">
        <p>کد به موبایل <b id="maskedMobile"></b> ارسال شد.</p>
        <div class="form-group">
            <label>کد تأیید *</label>
            <input type="text" id="OtpCode" class="form-control" maxlength="6" />
        </div>
        <button type="button" id="btnResendOtp" class="btn btn-link">ارسال مجدد</button>
        <span id="otpTimer"></span>
    </div>

    <div class="wizard-panel" id="step-3" style="display:none;">
        <div class="form-group">
            <label>رمز عبور *</label>
            <input type="password" id="Password" class="form-control" />
        </div>
        <div class="form-group">
            <label>تکرار رمز *</label>
            <input type="password" id="ConfirmPassword" class="form-control" />
        </div>
    </div>

    <div class="wizard-panel" id="step-4" style="display:none;">
        <div id="summaryContainer"></div>
    </div>

    <hr />

    <div class="wizard-nav">
        <button type="button" class="btn btn-secondary" id="btnPrev" disabled>قبلی</button>
        <button type="button" class="btn btn-primary" id="btnNext">بعدی</button>
        <button type="button" class="btn btn-success" id="btnSave" style="display:none;">ثبت نهایی</button>
    </div>
</div>

@section Styles {
    <style>
        .wizard-steps {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        .wizard-step {
            flex: 1;
            text-align: center;
            padding: 15px;
            border-bottom: 3px solid #ddd;
            opacity: .5;
        }

            .wizard-step.active {
                border-bottom-color: #007bff;
                opacity: 1;
            }

            .wizard-step.done {
                border-bottom-color: #28a745;
                opacity: 1;
            }

        .step-number {
            display: inline-block;
            width: 35px;
            height: 35px;
            line-height: 35px;
            border-radius: 50%;
            background: #007bff;
            color: #fff;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .step-title {
            display: block;
            font-size: 13px;
        }

        .wizard-nav {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
        }
    </style>
}

@section Scripts {
    <script>
    window.ApiClient = {
        baseUrl: '@Url.Content("~/")',
        post: function (url, data, success, fail) {
            return $.post(this.baseUrl + url, data, success).fail(fail);
        }
    };
    </script>
    <script src="~/Scripts/register-wizard.js"></script>
}