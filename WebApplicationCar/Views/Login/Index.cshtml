@{
    ViewBag.Title = "ورود به حساب";
}

<div class="container" style="margin-top:60px;">
    <div class="row">
        <div class="col-md-4 col-md-offset-4">
            <div class="panel panel-default">
                <div class="panel-heading text-center">
                    <h3 class="panel-title">ورود به حساب</h3>
                </div>
                <div class="panel-body">

                    <div class="form-group">
                        <label>شماره موبایل *</label>
                        <input type="text" id="Mobile" class="form-control"
                               placeholder="09xxxxxxxxx" maxlength="11"
                               dir="ltr" style="text-align:left;" />
                    </div>

                    <div class="form-group">
                        <label>رمز عبور *</label>
                        <input type="password" id="Password" class="form-control" dir="ltr" />
                    </div>

                    <!-- 👇 فیلد جدید: کد فروشگاه -->
                    <div class="form-group">
                        <label>کد فروشگاه *</label>
                        <input type="text" id="StoreCode" class="form-control"
                               placeholder="مثلاً STORE1 یا نام فروشگاه"
                               dir="ltr" style="text-align:left;" />
                        <small class="text-muted">
                            کد فروشگاهی که می‌خواهید وارد آن شوید را وارد کنید.
                        </small>
                    </div>

                    <div class="checkbox">
                        <label>
                            <input type="checkbox" id="RememberMe" /> مرا به خاطر بسپار
                        </label>
                    </div>

                    <button type="button" id="btnLogin" class="btn btn-primary btn-block">
                        ورود
                    </button>

                    <hr />

                    <div class="text-center">
                        <a href="@Url.Action("Index", "RegisterWizard")">ثبت‌نام نکرده‌اید؟</a>
                        <br />
                        <a href="@Url.Action("Index", "ForgotPassword")">رمز را فراموش کرده‌اید؟</a>
                    </div>

                    <div id="loginMessage" class="alert" style="display:none; margin-top:15px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.ApiClient = {
            baseUrl: '@Url.Content("~/")',
            loginUrl: '@Url.Action("Login", "Login")',
            feedUrl:  '@Url.Action("Feed", "Posts")',
            post: function (url, data, success, fail) {
                return $.post(this.baseUrl + url, data, success).fail(fail);
            }
        };

        window.ReturnUrl = '@(ViewBag.ReturnUrl ?? "")';
    </script>
    <script src="~/Scripts/login.js"></script>
}