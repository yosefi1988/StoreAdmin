@model WebApplicationCar.Models.HomeViewModel
@{
    ViewBag.Title = "صفحه اصلی";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:1100px; margin:20px auto; font-family:Tahoma; direction:rtl;">

    <!-- باکس جستجو -->
    <div style="text-align:center; margin:30px 0;">
        @using (Html.BeginForm("Index", "Products", FormMethod.Get))
        {
            <input type="text" name="search" placeholder="جستجوی ماشین..."
                   style="padding:10px; width:400px; border:1px solid #ccc; border-radius:5px;" />
                <button type="submit"
                        style="padding:10px 20px; background:#007bff; color:#fff; border:none; border-radius:5px; cursor:pointer;">
                    جستجو
                </button>
        }
    </div>

    <!-- اطلاعات فروشگاه -->
    @if (Model.Settings != null && !string.IsNullOrEmpty(Model.Settings.StoreNameFa))
    {
        <div style="background:#f8f9fa; padding:20px; border-radius:8px; margin-bottom:30px;">
            <h2 style="margin-top:0;">@Model.Settings.StoreNameFa</h2>
            <p><strong>آدرس:</strong> @Model.Settings.Address</p>
            <p><strong>ساعات کاری:</strong> @Model.Settings.WorkingHours</p>
            <p><strong>تلفن:</strong> @Model.Settings.PhoneNumber</p>
            <p><strong>ایمیل:</strong> @Model.Settings.Email</p>
        </div>
    }

    <!-- آخرین ماشین‌ها -->
    <h3>آخرین ماشین‌های ثبت‌شده</h3>
    <div style="display:flex; flex-wrap:wrap; gap:15px; margin-top:15px;">
        @foreach (var car in Model.LatestCars)
        {
            <div style="border:1px solid #ddd; border-radius:8px; width:180px; padding:10px; text-align:center;">
                <img src="@car.ImageUrl" alt="@car.NameFa"
                     style="width:100%; height:110px; object-fit:cover; border-radius:5px;" />
                <h4 style="margin:8px 0;">@car.NameFa</h4>
                <p style="color:#28a745; margin:5px 0;">
                    @(car.Price.HasValue ? car.Price.Value.ToString("N0") + " تومان" : "تماس بگیرید")
                </p>
            </div>
        }
    </div>

    <!-- دکمه ادامه به Scroll -->
    <div style="text-align:center; margin:30px 0;">
        <a href="@Url.Action("Scroll", "Products")"
           style="padding:12px 30px; background:#28a745; color:#fff; text-decoration:none; border-radius:5px;">
            مشاهده همه ماشین‌ها
        </a>
    </div>
    

    <div style="text-align:center; margin:30px 0;">
        <a href="@Url.Action("Create", "ProductWizard")"
           style="padding:12px 30px; background:#28a745; color:#fff; text-decoration:none; border-radius:5px;">
            ثبت جدید
        </a>
    </div>
</div>