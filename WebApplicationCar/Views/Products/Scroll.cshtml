@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var mine = ViewBag.Mine == true;
    var filterUserName = ViewBag.FilterUserName as string ?? "";
    var filterCategoryId = ViewBag.FilterCategoryId as int?;
    var filterCategoryName = ViewBag.FilterCategoryName as string ?? "";
    var hasAnyFilter = mine || !string.IsNullOrEmpty(filterUserName) || filterCategoryId.HasValue;
    ViewBag.Title = mine ? "محصولات من" : "لیست خودروها";
}

<div class="container" style="margin-top:20px;">
    <h2>@ViewBag.Title</h2>
    <hr />

    <!-- دکمه‌های فیلتر -->
    <div class="row" style="margin-bottom:15px;">
        <div class="col-md-12">
            @if (!mine)
            {
                <a href="@Url.Action("Scroll", "Products", new { mine = true })" class="btn btn-info">
                    <i class="fa fa-user"></i> فقط محصولات من
                </a>
            }
            else
            {
                <a href="@Url.Action("Scroll", "Products")" class="btn btn-default">
                    <i class="fa fa-list"></i> نمایش همه محصولات
                </a>
            }

            <a href="@Url.Action("Scroll", "Products")" class="btn btn-default">
                <i class="fa fa-list"></i> همه
            </a>
        </div>
    </div>

    <!-- نمایش فیلترهای فعال -->
    @if (hasAnyFilter)
    {
        <div class="alert alert-info" style="margin-bottom:20px;">
            <i class="fa fa-filter"></i>
            <strong>فیلترهای فعال:</strong>

            @if (!string.IsNullOrEmpty(filterUserName))
            {
                <span class="label label-primary" style="margin:0 5px;">
                    <i class="fa fa-user"></i> کاربر: @filterUserName
                    <a href="@Url.Action("Scroll", "Products", new {
                        categoryId = filterCategoryId,
                        mine = mine ? (bool?)true : null
                    })" style="color:white; margin-right:5px;">×</a>
                </span>
            }

            @if (filterCategoryId.HasValue)
            {
                <span class="label label-success" style="margin:0 5px;">
                    <i class="fa fa-folder-open"></i> دسته: @filterCategoryName
                    <a href="@Url.Action("Scroll", "Products", new {
                        userName = filterUserName,
                        mine = mine ? (bool?)true : null
                    })" style="color:white; margin-right:5px;">×</a>
                </span>
            }

            @if (!mine && (!string.IsNullOrEmpty(filterUserName) || filterCategoryId.HasValue))
            {
                <a href="@Url.Action("Scroll", "Products")" class="btn btn-xs btn-default" style="margin-right:10px;">
                    <i class="fa fa-times"></i> حذف همه
                </a>
            }
        </div>
    }

    <div class="row" id="productsContainer"></div>

    <div id="loading" style="display:none; text-align:center; padding:30px;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">در حال بارگذاری...</span>
        </div>
        <p>در حال بارگذاری...</p>
    </div>

    <div id="endMessage" style="display:none; text-align:center; padding:30px; color:#888;">
        <p>— به پایان لیست رسیدید —</p>
    </div>

    <div id="error" class="alert alert-danger" style="display:none;"></div>
</div>

@section Styles {
    <style>
        .product-card {
            background: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 20px;
            transition: all 0.3s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

            .product-card:hover {
                box-shadow: 0 5px 15px rgba(0,0,0,0.15);
                transform: translateY(-3px);
            }

            .product-card .card-img {
                width: 100%;
                height: 200px;
                object-fit: cover;
                background: #f5f5f5;
            }

            .product-card .card-body {
                padding: 15px;
            }

            .product-card .card-title {
                font-size: 16px;
                font-weight: bold;
                margin: 0 0 8px 0;
                color: #333;
            }

            .product-card .card-subtitle {
                font-size: 13px;
                color: #888;
                margin: 0 0 10px 0;
            }

            .product-card .card-meta {
                font-size: 12px;
                color: #666;
                margin: 5px 0;
            }

            .product-card .card-footer {
                padding: 10px 15px;
                background: #f9f9f9;
                border-top: 1px solid #eee;
            }

        .no-image {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f0f0f0;
            color: #aaa;
            font-size: 14px;
        }
    </style>
}

@section Scripts {
    <script>
        var ApiClient = {
            baseUrl: '@Url.Content("~/")'
        };
        window.ProductsFilter = {
            mine: @(mine ? "true" : "false"),
            userName: '@Html.Raw(HttpUtility.JavaScriptStringEncode(filterUserName))',
            categoryId: @(filterCategoryId.HasValue ? filterCategoryId.Value.ToString() : "null"),
            categoryName: '@Html.Raw(HttpUtility.JavaScriptStringEncode(filterCategoryName))'
        };
    </script>
    <script src="~/Scripts/products-scroll.js"></script>
}