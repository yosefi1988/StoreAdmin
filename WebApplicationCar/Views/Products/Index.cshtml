@{
    ViewBag.Title = "لیست خودروها";
    string search = ViewBag.Search as string ?? "";
}

<div class="container" style="margin-top:20px;">
    <h2>لیست خودروها</h2>
    <hr />

    <!-- فیلتر و جستجو -->
    <div class="row" style="margin-bottom:15px;">
        <div class="col-md-4">
            <input type="text" id="txtSearch" class="form-control"
                   placeholder="جستجو (نام، کد محصول)..."
                   value="@search" />        </div>
        <div class="col-md-2">
            <select id="ddlPageSize" class="form-control">
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    <!-- Loading -->
    <div id="loading" style="display:none;" class="text-center">
        <p>در حال بارگذاری...</p>
    </div>

    <!-- Error -->
    <div id="error" class="alert alert-danger" style="display:none;"></div>

    <!-- جدول -->
    <table class="table table-striped table-bordered" id="tblProducts">
        <thead>
            <tr>
                <th>شناسه</th>
                <th>نام فارسی</th>
                <th>نام انگلیسی</th>
                <th>کد محصول</th>
                <th>بارکد</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <!-- صفحه‌بندی -->
    <nav>
        <ul class="pagination" id="pagination"></ul>
    </nav>

    <!-- اطلاعات -->
    <div class="text-muted" id="paginationInfo"></div>
</div>
 
@section Scripts {
    <script>
        window.INITIAL_SEARCH = '@search';
        window.ApiClient = {
            baseUrl: '@Url.Content("~/")'
        };
    </script>
    <script src="~/Scripts/products-list.js"></script>
}
 